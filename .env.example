# Only for Docker Compose. Normal local setup uses backend/.env and frontend/.env.local.
POSTGRES_PASSWORD=
SECRET_KEY=
AI_PROVIDER=perplexity
AI_ENABLED=true
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=perplexity/sonar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Web Push: generated by backend/configure_push.py; private key stays server-side
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDER_POLL_INTERVAL_SECONDS=10

# Optional reminder email; configure identically on API and worker.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Set FRONTEND_URL to the public HTTPS Xenon URL on API and worker.
# EMAIL_PROVIDER=resend, EMAIL_FROM=Xenon <reminders@your-verified-domain>,
# RESEND_API_KEY must be set on both API and worker; never in frontend env.
# Verification links expire in 1h; reminders require verification and Settings opt-in.
