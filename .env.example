# Only for Docker Compose. Normal local setup uses backend/.env and frontend/.env.local.
POSTGRES_PASSWORD=
SECRET_KEY=
AI_PROVIDER=perplexity
AI_ENABLED=true
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=perplexity/sonar
# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Web Push: generated by backend/configure_push.py; private key stays server-side
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDER_POLL_INTERVAL_SECONDS=10

# Optional reminder email; configure identically on API and worker.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
